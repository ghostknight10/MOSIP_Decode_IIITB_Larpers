# MOSIP Interoperability Playground Environment Configuration

# Backend BFF Configuration
PORT=4000
NODE_ENV=development
# Origins allowed to call the BFF directly (comma-separated). The UI normally
# goes through the Vite proxy, which is same-origin and needs no CORS.
FRONTEND_URL=http://localhost:5173

# MOSIP Collab Sandbox Endpoints (these resolve and answer as of 2026-10-25)
MOSIP_INJI_CERTIFY_URL=https://injicertify-mosipid.collab.mosip.net
MOSIP_INJI_MIMOTO_URL=https://api.collab.mosip.net
MOSIP_INJI_VERIFY_URL=https://injiverify.collab.mosip.net

# Optional shared secret. When set, the BFF answers /api requests only with a
# matching x-playground-token header, which the frontend's Vite proxy adds.
# Set it for any deployment reachable by others (S-2).
PLAYGROUND_TOKEN=
