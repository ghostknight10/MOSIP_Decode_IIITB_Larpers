# MOSIP VC Interoperability Playground: environment configuration
#
# Copy to .env in the repo root: cp .env.example .env
# The BFF, the Vite dev server and docker compose all read that one file.
# .env is git-ignored; never commit real secrets.

# ----- Backend (BFF) -----
PORT=4000
NODE_ENV=development
# Origins allowed to call the BFF directly (comma-separated). The UI normally
# goes through the Vite proxy, which is same-origin and needs no CORS.
FRONTEND_URL=http://localhost:5173

# ----- MOSIP Collab sandbox endpoints (they answer as of 2026-10-25) -----
MOSIP_INJI_CERTIFY_URL=https://injicertify-mosipid.collab.mosip.net
MOSIP_INJI_MIMOTO_URL=https://api.collab.mosip.net
MOSIP_INJI_VERIFY_URL=https://injiverify.collab.mosip.net

# ----- Real Inji issuance (E-1) -----
# With a Collab test identity, choosing Inji Certify + W3C VC logs in to
# eSignet (mock identity system, OTP), gets a token through Mimoto and asks
# Inji Certify (Land Registry instance) for a real credential.
# 8267411578 is one of MOSIP's published test identities with Land Registry
# data. Empty it to emulate the credential instead (faster, works offline).
COLLAB_TEST_INDIVIDUAL_ID=8267411578
# The mock identity system's test OTP.
COLLAB_TEST_OTP=111111
# Other Collab issuers can be tried by overriding these (defaults shown):
# COLLAB_ESIGNET_URL=https://esignet-mock.collab.mosip.net
# COLLAB_LOGIN_CERTIFY_URL=https://injicertify-landregistry.collab.mosip.net
# COLLAB_MIMOTO_ISSUER_ID=Land
# COLLAB_CLIENT_ID=mpartner-default-mimoto-land-oidc
# COLLAB_REDIRECT_URI=io.mosip.residentapp.inji://oauthredirect
# COLLAB_SCOPE=land_statement_vc_ldp
# COLLAB_CREDENTIAL_CONFIGURATION_ID=LandStatementCredential

# ----- Walt.id (independent, non-MOSIP implementation; public demo) -----
# WALT_ISSUER_URL=https://issuer.portal.walt.id
# WALT_VERIFIER_URL=https://verifier.portal.walt.id

# ----- Access control (S-2) -----
# When set, the BFF answers /api requests only with a matching
# x-playground-token header, which the Vite proxy adds for you. Set a long
# random value for any deployment other people can reach, e.g.:
#   openssl rand -hex 24
PLAYGROUND_TOKEN=

# ----- Frontend (Vite dev server) -----
# Where the /api proxy sends requests. docker compose sets http://bff:4000.
VITE_BFF_URL=http://localhost:4000

# ----- Tools (optional) -----
# BFF used by `npm run test:interop` (falls back to the mock engine if down).
# BFF_URL=http://localhost:4000
# Upstream for the proxy gateway's MOCK_ISSUER / MOCK_VERIFIER targets.
# MOCK_URL=http://localhost:5001
