{
  "name": "mosip-decode-iiitb-larpers",
  "version": "1.0.0",
  "private": true,
  "description": "MOSIP Verifiable Credential (VC) Interoperability Playground",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "test:interop": "npm --prefix backend run test:interop",
    "report:interop": "npm --prefix backend run report:interop --"
  },
  "keywords": [
    "mosip",
    "inji",
    "openid4vci",
    "openid4vp",
    "verifiable-credentials",
    "sd-jwt"
  ],
  "author": "Yug & Team Larpers",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  }
}
